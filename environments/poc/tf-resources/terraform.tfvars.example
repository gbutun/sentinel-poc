# Copy to terraform.tfvars and adjust. Non-secret values only.

company_name_long  = "Contoso"
company_name_short = "contoso"

product_name_short = "sentinel"
product_unique     = "sen"

environment_short = "poc"
environment_long  = "POC"

rg_01_location_long  = "westeurope"
rg_01_location_short = "weu"

la_ws_01_retention_in_days = 90
la_ws_01_daily_quota_gb    = 5

# ── Arc machines (on-prem Windows + Linux servers) ────────────────────────────
# Leave empty to place the Arc objects in the POC resource group.
arc_machines_resource_group_name = ""
arc_windows_machine_name         = "onprem-win-01"
arc_linux_machine_name           = "onprem-lnx-01"

# Stage 1: false  -> deploy workspace + Sentinel + DCRs + Arc onboarding SP
# Stage 2 (after `azcmagent connect` on both servers): flip to true and re-apply
associate_arc_machines = false
deploy_ama_extensions  = false

# ── On-prem syslog/CEF forwarder (in front of Fortinet firewall + switch) ──────
arc_syslog_forwarder_machine_name = "onprem-fwd-01"
collect_fortinet_cef              = true
collect_network_syslog            = true
# Stage 3 (after setup-linux-forwarder.sh on the forwarder VM): flip to true
associate_syslog_forwarder     = false
deploy_forwarder_ama_extension  = false

enable_azure_activity_connector = true
enable_sample_analytics_rules   = true
enable_fortinet_sample_rule     = true
