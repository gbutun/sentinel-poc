# Terraform local working directories and state
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.exe
sensitive*
# Local Terraform variable overrides and backend config
*.auto.tfvars
*.auto.tfvars.json
*.tfvars
*.tfvars.json
backend.hcl
**/plans/
**/outputs/

# Keep example variable files only
!*.tfvars.example

# Keep provider lock files tracked
!.terraform.lock.hcl

# Onboarding scripts carry real tenant/subscription/SP values - keep out of GitHub
onboarding/

